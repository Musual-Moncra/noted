Screen {
    background: #1a1b26;
    color: #c0caf5;
}

Header {
    background: #1f2335;
    color: #7aa2f7;
    text-style: bold;
}

Footer {
    background: #1f2335;
    color: #a9b1d6;
}
#main-container {
    layout: horizontal;
    height: 1fr;
    background: #1a1b26;
}

#sidebar {
    width: 32;
    min-width: 26;
    max-width: 36;
    height: 1fr;
    border-right: solid #292e42;
    background: #1f2335;
    padding: 0 1;
}

#search-input {
    margin-top: 1;
    margin-bottom: 1;
    background: #24283b;
    border: round #3b4261;
    color: #c0caf5;
}

#search-input:focus {
    border: round #7aa2f7;
}

#notes-list {
    height: 1fr;
    background: transparent;
    scrollbar-size-vertical: 1;
}

.note-item-text {
    padding: 0 1;
}

ListItem {
    padding: 1 0;
    background: transparent;
    border-bottom: solid #292e42;
}

ListItem:hover {
    background: #24283b;
}

ListItem.-selected {
    background: #283456;
    border-left: thick #7aa2f7;
}

#content-area {
    width: 1fr;
    height: 1fr;
    background: #1a1b26;
}

#metadata-header {
    height: 4;
    border-bottom: solid #292e42;
    padding: 0 1;
    background: #1f2335;
    layout: vertical;
}

#metadata-info {
    width: 100%;
    height: 1;
    content-align: left middle;
}

#mode-button-group {
    width: 100%;
    height: 1;
    margin-top: 1;
    layout: horizontal;
    overflow-x: auto;
    scrollbar-size-horizontal: 0;
}

.mode-btn {
    min-width: 7;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    border: none;
    background: #24283b;
    color: #7982a9;
}

.mode-btn:hover {
    background: #3b4261;
    color: #c0caf5;
}

.mode-btn.-active {
    background: #7aa2f7;
    color: #15161e;
    text-style: bold;
}

#main-workspace {
    layout: horizontal;
    height: 1fr;
    width: 1fr;
    background: #1a1b26;
}

#view-container {
    height: 1fr;
    width: 1fr;
    padding: 1 2;
    overflow-y: auto;
    background: #1a1b26;
}

#edit-container {
    height: 1fr;
    width: 1fr;
    padding: 0;
    background: #1a1b26;
}

#formatting-toolbar {
    height: 3;
    background: #1f2335;
    border-bottom: solid #292e42;
    padding: 0 1;
    align-vertical: middle;
    overflow-x: auto;
    scrollbar-size-horizontal: 0;
}

.fmt-btn {
    min-width: 4;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    border: none;
    background: #24283b;
    color: #a9b1d6;
}

.fmt-btn:hover {
    background: #7aa2f7;
    color: #15161e;
}

#text-editor {
    height: 1fr;
    border: none;
    background: #1a1b26;
}

/* Modal styles */
ModalScreen {
    align: center middle;
    background: rgba(15, 16, 24, 0.7);
}

.modal-dialog {
    width: 68;
    max-width: 90%;
    max-height: 85%;
    overflow-y: auto;
    height: auto;
    background: #1f2335;
    border: round #7aa2f7;
    padding: 1 2;
}

.modal-buttons {
    layout: horizontal;
    align: right middle;
    margin-top: 1;
    height: auto;
}

.modal-buttons Button {
    margin-left: 2;
}

.dialog-title {
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 1;
}

.help-row {
    layout: horizontal;
    margin-bottom: 1;
}

.key-badge {
    width: 14;
    color: #bb9af7;
    text-style: bold;
}

.color-choice-row {
    layout: horizontal;
    height: 1;
    margin-bottom: 0;
    align-vertical: middle;
}

.key-badge-small {
    width: 6;
    color: #bb9af7;
    text-style: bold;
}

.color-choice-btn {
    height: 1;
    min-width: 44;
    border: none;
    background: #24283b;
    color: #c0caf5;
    padding: 0 1;
}

.color-choice-btn:hover {
    background: #7aa2f7;
    color: #15161e;
}

#locked-note-card {
    width: 100%;
    max-width: 50;
    height: auto;
    background: #1f2335;
    border: round #7aa2f7;
    padding: 0 1;
    margin: 0 1;
    align: center middle;
}

#locked-card-title {
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 0;
    content-align: center middle;
}

#locked-card-desc {
    content-align: center middle;
    margin-bottom: 1;
    color: #a9b1d6;
}

#btn-screen-unlock {
    min-width: 22;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#manage-lock-options {
    height: auto;
    margin-bottom: 1;
}

#manage-lock-options Button {
    width: 100%;
    margin-bottom: 1;
}
