Screen {
    background: $surface-darken-1;
}

#main-container {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 32;
    min-width: 26;
    max-width: 36;
    height: 1fr;
    border-right: vkey $primary;
    background: $surface;
    padding: 0 1;
}

#search-input {
    margin-top: 1;
    margin-bottom: 1;
}

#notes-list {
    height: 1fr;
    background: transparent;
}

.note-item {
    padding: 1;
    background: $surface;
    border-bottom: solid $surface-lighten-1;
}

.note-item:hover {
    background: $surface-lighten-1;
}

.note-item.-selected {
    background: $primary-darken-1;
    color: $text;
}

#content-area {
    width: 1fr;
    height: 1fr;
    background: $background;
}

#metadata-header {
    height: 4;
    border-bottom: solid $primary-darken-2;
    padding: 0 1;
    background: $surface-darken-1;
    layout: vertical;
}

#metadata-info {
    width: 100%;
    height: 1;
    content-align: left middle;
}

#mode-button-group {
    width: 100%;
    height: 1;
    margin-top: 1;
    layout: horizontal;
    overflow-x: auto;
    scrollbar-size-horizontal: 0;
}

.mode-btn {
    min-width: 7;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    border: none;
    background: $surface;
    color: $text-muted;
}

.mode-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.mode-btn.-active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#main-workspace {
    layout: horizontal;
    height: 1fr;
    width: 1fr;
}

#view-container {
    height: 1fr;
    width: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

#edit-container {
    height: 1fr;
    width: 1fr;
    padding: 0;
}

#formatting-toolbar {
    height: 3;
    background: $surface;
    border-bottom: solid $primary-darken-2;
    padding: 0 1;
    align-vertical: middle;
    overflow-x: auto;
    scrollbar-size-horizontal: 0;
}


.fmt-btn {
    min-width: 4;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    border: none;
    background: $surface-lighten-1;
    color: $text;
}

.fmt-btn:hover {
    background: $primary;
    color: $text;
}

#text-editor {
    height: 1fr;
    border: none;

}

/* Modal styles */
ModalScreen {
    align: center middle;
}

.modal-dialog {
    width: 68;
    max-width: 90%;
    max-height: 85%;
    overflow-y: auto;
    height: auto;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

.modal-buttons {
    layout: horizontal;
    align: right middle;
    margin-top: 1;
    height: auto;
}

.modal-buttons Button {
    margin-left: 2;
}

.dialog-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.help-row {
    layout: horizontal;
    margin-bottom: 1;
}

.key-badge {
    width: 14;
    color: $accent;
    text-style: bold;
}

.color-choice-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
    align-vertical: middle;
}

.key-badge-small {
    width: 6;
    color: $accent;
    text-style: bold;
}

.color-choice-btn {
    height: 1;
    min-width: 44;
    border: none;
    background: $surface-lighten-1;
    color: $text;
    padding: 0 1;
}

.color-choice-btn:hover {
    background: $primary;
    color: $text;
}

#locked-note-card {
    width: 100%;
    max-width: 50;
    height: auto;
    background: $surface;
    border: thick $primary;
    padding: 0 1;
    margin: 0 1;
    align: center middle;
}

#locked-card-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 0;
    content-align: center middle;
}

#locked-card-desc {
    content-align: center middle;
    margin-bottom: 1;
}

#btn-screen-unlock {
    min-width: 22;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

