Screen { background: $noted-base; color: $noted-text; }
Header { height: 1; background: $noted-panel; color: $noted-accent; text-style: bold; }
Footer { height: 1; background: $noted-panel; color: $noted-muted; }
#main-container { height: 1fr; layout: horizontal; }
#navigation { width: 24; background: $noted-panel; border-right: solid $noted-border; padding: 0 1; scrollbar-size: 1 1; }
#sidebar { width: 30; background: $noted-panel; border-right: solid $noted-border; padding: 0 1; }
Screen.-compact #sidebar { width: 26; }
Screen.-narrow #sidebar { layer: overlay; dock: left; width: 28; max-width: 90%; }
Screen.-compact #navigation { layer: overlay; dock: left; width: 24; max-width: 85%; }
Screen.-narrow #navigation { layer: overlay; dock: left; width: 24; max-width: 85%; }
#content-area { width: 1fr; min-width: 16; }
.section-label { height: 1; margin-top: 1; color: $noted-muted; text-style: bold; }
.nav-btn { width: 1fr; height: 3; min-width: 1; text-align: left; padding: 0 1; }
#nav-capture { width: 100%; min-width: 1; height: 3; margin-top: 1; }
#folder-tree { height: auto; min-height: 3; max-height: 14; background: transparent; scrollbar-size: 1 1; }
#tag-list { height: auto; max-height: 12; background: transparent; scrollbar-size: 1 1; }
#tag-list ListItem { height: 1; padding: 0; border-left: thick transparent; }
Input { background: $noted-surface; color: $noted-text; border: round $noted-border; }
Input:focus { border: round $noted-accent; }
#search-input { margin-top: 1; }
#tag-search { height: 1; border: none; margin-top: 1; }
#list-scope { height: 1; margin-bottom: 1; text-style: bold; color: $noted-text; }
.compact-row { height: auto; min-height: 3; }
.compact-btn { height: 3; min-width: 3; padding: 0 1; margin-right: 1; }
#sort-order { width: 1fr; height: 1; margin: 1 1 0 0; }
#filter-more { width: 10; }
#recursive-filter { height: 1; padding: 0; border: none; background: transparent; margin-top: 1; }
#active-filters { height: auto; max-height: 2; color: $noted-secondary; }
#notes-list { height: 1fr; background: transparent; scrollbar-size: 1 1; }
#notes-list ListItem { height: 6; padding: 1 1; border-bottom: solid $noted-border; border-left: thick transparent; }
.note-item-text { height: 3; text-overflow: ellipsis; text-wrap: nowrap; }
ListItem:hover { background: $noted-surface; }
ListItem.-highlight { background: $noted-selected; }
ListView:focus ListItem.-highlight { border-left: thick $noted-accent; }
#list-empty { height: auto; color: $noted-muted; }
#page-controls { height: 3; margin: 1 0; }
#page-status { width: 1fr; height: 3; content-align: center middle; color: $noted-muted; }
#metadata-header { height: 7; padding: 0 1; background: $noted-panel; border-bottom: solid $noted-border; }
#metadata-info { width: 100%; height: 1; text-style: bold; text-overflow: ellipsis; text-wrap: nowrap; }
#metadata-details { height: 1; color: $noted-muted; text-overflow: ellipsis; text-wrap: nowrap; }
#mode-button-group { height: 3; margin-top: 1; }
.mode-btn { height: 3; min-width: 5; padding: 0 1; margin-right: 1; }
#save-status { height: 3; content-align: right middle; width: 1fr; min-width: 5; text-align: right; color: $noted-muted; }
#resource-status { height: auto; max-height: 2; color: $noted-warning; padding: 0 1; }
#main-workspace { height: 1fr; }
#edit-container, #view-container { width: 1fr; height: 1fr; }
#edit-container { display: none; }
#view-container { padding: 1 2; scrollbar-size: 1 1; align-horizontal: center; }
#markdown-viewer { width: 100%; }
#render-full { display: none; }
#formatting-toolbar { height: 3; padding: 0 1; background: $noted-panel; overflow-x: auto; scrollbar-size-horizontal: 0; }
.fmt-btn { min-width: 3; height: 3; padding: 0 1; margin-right: 1; }
#text-editor { height: 1fr; border: none; border-left: solid transparent; background: $noted-base; }
#text-editor:focus { border-left: solid $noted-accent; }
#empty-actions { height: auto; align: center middle; padding: 1 0; }
#empty-actions Button { min-width: 14; margin: 0 1; }
#main-container Button:disabled { opacity: 40%; }
Screen.-motion Button { transition: background 100ms, color 100ms; }
Screen.-motion Input { transition: border-top 100ms, border-bottom 100ms; }
/* Modal styles */
ModalScreen {
    align: center middle;
    background: rgba(15, 16, 24, 0.7);
}

.modal-dialog {
    width: 68;
    max-width: 90%;
    max-height: 85%;
    overflow-y: auto;
    height: auto;
    background: #1f2335;
    border: round #7aa2f7;
    padding: 1 2;
}

.modal-buttons {
    layout: horizontal;
    align: right middle;
    margin-top: 1;
    height: auto;
}

.modal-buttons Button {
    margin-left: 2;
}

.dialog-title {
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 1;
}

.help-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.key-badge {
    width: 14;
    color: #bb9af7;
    text-style: bold;
}

.color-choice-row {
    layout: horizontal;
    height: 1;
    margin-bottom: 0;
    align-vertical: middle;
}

.key-badge-small {
    width: 6;
    color: #bb9af7;
    text-style: bold;
}

.color-choice-btn {
    height: 1;
    min-width: 44;
    border: none;
    background: #24283b;
    color: #c0caf5;
    padding: 0 1;
}

.color-choice-btn:hover {
    background: #7aa2f7;
    color: #15161e;
}


.menu-action { height: 3; width: 100%; margin-bottom: 1; }
#locked-note-card {
    display: none;
    width: 50;
    max-width: 90%;
    height: auto;
    background: #1f2335;
    border: round #7aa2f7;
    padding: 1 2;
    margin: 1 0;
    align: center middle;
}

#locked-card-title {
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 0;
    content-align: center middle;
}

#locked-card-desc {
    content-align: center middle;
    margin-bottom: 1;
    color: #a9b1d6;
}

#btn-screen-unlock {
    min-width: 22;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#manage-lock-options { height: auto; margin-bottom: 1; }
#manage-lock-options Button { width: 100%; margin-bottom: 1; }
#folder-picker-tree { height: 12; background: $noted-surface; }
#prompt-suggestions { color: $noted-secondary; margin-top: 1; }
.error-msg { color: $noted-error; }

MarkdownH1 { color: $noted-text; background: transparent; content-align: left middle; margin: 1 0; text-style: bold; }
MarkdownH2 { color: $noted-accent; background: transparent; text-style: bold; margin: 1 0; }
MarkdownH3 { color: $noted-secondary; text-style: bold; }

.footer-btn { height: 1; min-width: 1; width: auto; border: none; padding: 0 1; margin: 0; color: $noted-muted; background: transparent; }

/* New three-button dialogs still fit inside the original popup width. */
#folder-new, #folder-cancel, #folder-move, #filter-clear, #filter-cancel, #filter-apply { min-width: 8; }

/* Keep shortcut hints in their single-row footer. */
.footer-btn:hover, .footer-btn.-active { border: none; }

/* Focus keeps the raised button appearance without reversing the label. */
Button:focus { text-style: bold; background-tint: transparent; }

/* Responsive adjustments for scaled / shrunk viewports */
Screen.-short #metadata-header { height: 4; }
Screen.-short #metadata-details { display: none; }
Screen.-short #mode-button-group { height: 1; margin-top: 1; }
Screen.-short .mode-btn { height: 1; min-width: 4; border: none; padding: 0 1; }
Screen.-short #save-status { height: 1; }
Screen.-short #formatting-toolbar { height: 1; }
Screen.-short .fmt-btn { height: 1; border: none; }
Screen.-short #notes-list ListItem { height: 4; padding: 0 1; }
Screen.-short #view-container { padding: 0 1; }

Screen.-compact #btn-mode-split { display: none; }
Screen.-narrow #btn-mode-split { display: none; }
Screen.-narrow .mode-btn { min-width: 4; padding: 0; margin-right: 1; }
Screen.-narrow .footer-btn { padding: 0; margin-right: 1; }
Screen.-narrow #footer-new,
Screen.-narrow #footer-help { display: none; }
