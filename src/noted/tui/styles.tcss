Screen {
    background: $surface-darken-1;
}

#main-container {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 36;
    height: 1fr;
    border-right: vkey $primary;
    background: $surface;
    padding: 0 1;
}

#search-input {
    margin-top: 1;
    margin-bottom: 1;
}

#notes-list {
    height: 1fr;
    background: transparent;
}

.note-item {
    padding: 1;
    background: $surface;
    border-bottom: solid $surface-lighten-1;
}

.note-item:hover {
    background: $surface-lighten-1;
}

.note-item.-selected {
    background: $primary-darken-1;
    color: $text;
}

#content-area {
    width: 1fr;
    height: 1fr;
    background: $background;
}

#metadata-header {
    height: 3;
    border-bottom: solid $primary-darken-2;
    padding: 0 1;
    background: $surface-darken-1;
    layout: horizontal;
    align-vertical: middle;
}

#metadata-info {
    width: 1fr;
    content-align: left middle;
}

#mode-button-group {
    width: auto;
    height: 1;
    align: right middle;
}

.mode-btn {
    min-width: 10;
    height: 1;
    padding: 0 1;
    margin-left: 1;
    border: none;
    background: $surface;
    color: $text-muted;
}

.mode-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.mode-btn.-active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#main-workspace {
    layout: horizontal;
    height: 1fr;
    width: 1fr;
}

#view-container {
    height: 1fr;
    width: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

#edit-container {
    height: 1fr;
    width: 1fr;
    padding: 0;
}

#formatting-toolbar {
    height: 3;
    background: $surface;
    border-bottom: solid $primary-darken-2;
    padding: 0 1;
    align-vertical: middle;
}

.fmt-btn {
    min-width: 8;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    border: none;
    background: $surface-lighten-1;
    color: $text;
}

.fmt-btn:hover {
    background: $primary;
    color: $text;
}

#text-editor {
    height: 1fr;
    border: none;
}

/* Modal styles */
.modal-dialog {
    width: 64;
    height: auto;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
    align: center middle;
}

.modal-buttons {
    layout: horizontal;
    align: right middle;
    margin-top: 1;
    height: auto;
}

.modal-buttons Button {
    margin-left: 2;
}

.dialog-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.help-row {
    layout: horizontal;
    margin-bottom: 1;
}

.key-badge {
    width: 14;
    color: $accent;
    text-style: bold;
}
